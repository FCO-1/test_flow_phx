# TestFlow — plantilla de entorno para Docker. Copiá a `.env` y ajustá.
#   cp .env.example .env
#
# `.env` está git-ignored (lleva el secreto). Esta plantilla SÍ se versiona.

# Puerto de la UI web (host y contenedor usan el mismo). Cambialo libremente
# para evitar choques con otros servicios. Accedés en http://localhost:${PORT}
PORT=4100

# Host para la generación de URLs (no afecta el acceso local por el puerto).
PHX_HOST=localhost

# Secreto para firmar/cifrar cookies y sesiones de LiveView. OBLIGATORIO.
# Generá uno propio (64+ chars) con cualquiera de estas opciones:
#   - mix phx.gen.secret
#   - openssl rand -base64 48
#   - PowerShell: [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))
SECRET_KEY_BASE=GENERAME_CON_mix_phx.gen.secret_O_openssl_rand_base64_48

# Dónde guarda el contenedor sus datos (montado como volumen). Normalmente /data.
TEST_FLOW_DATA_DIR=/data
